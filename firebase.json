{
	"firestore": {
		"rules": "database/firestore.rules",
		"indexes": "database/firestore.indexes.json"
	},
	"hosting": {
		"site": "happybirthday-6d8ee",
		"public": ".",
		"ignore": [
			"firebase.json",
			"firebase.yaml",
			"firebase-debug.log",
			".firebaserc",
			".github/**",
			".agents/**",
			".firebase/**",
			"functions/**",
			"database/**",
			"dataconnect/**",
			"public/**",
			"backend/**",
			"apis/**",
			"Birthday-Wishishes/**",
			"apphosting.yaml",
			"apphosting.emulator.yaml",
			"database.rules.json",
			"storage.rules",
			"remoteconfig.template.json",
			"README.md",
			"node_modules/**",
			"**/node_modules/**"
		],
		"headers": [
			{
				"source": "**",
				"headers": [
					{ "key": "X-Content-Type-Options", "value": "nosniff" },
					{ "key": "X-Frame-Options", "value": "DENY" },
					{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
					{ "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
					{ "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' https://www.gstatic.com; connect-src 'self' https://www.gstatic.com https://*.googleapis.com https://*.firebaseio.com https://securetoken.googleapis.com https://us-central1-happybirthday-6d8ee.cloudfunctions.net; frame-src 'self' https://happybirthday-6d8ee.firebaseapp.com https://accounts.google.com; form-action 'self' https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
				]
			},
			{
				"source": "index.html",
				"headers": [
					{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
				]
			},
			{
				"source": "**/*.@(js|css)",
				"headers": [
					{ "key": "Cache-Control", "value": "no-cache" }
				]
			},
			{
				"source": "image/*",
				"headers": [
					{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
				]
			}
		]
	},
	"functions": {
		"source": "functions"
	}
}