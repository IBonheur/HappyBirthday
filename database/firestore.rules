rules_version = '2';

service cloud.firestore {
	match /databases/{database}/documents {
		match /birthdayWishes/{wishId} {
			allow read: if isAnonymousUser() || isAdmin();
			allow create: if (isAnonymousUser() || isAdmin())
				&& wishId.matches('^[a-f0-9]{64}$')
				&& request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
				&& request.resource.data.name is string
				&& request.resource.data.name.size() > 0
				&& request.resource.data.name.size() <= 40
				&& request.resource.data.message is string
				&& request.resource.data.message.size() > 0
				&& request.resource.data.message.size() <= 140
				&& request.resource.data.createdAt is timestamp;
			allow update, delete: if isAdmin();
		}

		function isAnonymousUser() {
			return request.auth != null
				&& request.auth.token.firebase.sign_in_provider == 'anonymous';
		}

		function isAdmin() {
			return request.auth != null
				&& request.auth.token.email == 'ishimwebon@gmail.com'
				&& request.auth.token.email_verified == true;
		}
	}
}
